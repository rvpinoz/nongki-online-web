# Contoh environment server (set lewat PM2/systemd/hosting; file ini tidak dibaca otomatis)
PORT=4000
NODE_ENV=production
# Origin frontend yang diizinkan (WAJIB di production), pisahkan dengan koma
CLIENT_ORIGIN=https://nongki.contoh.com
# Maks. peserta per room (mesh). Default 8, dibatasi 2–12.
MAX_PARTICIPANTS=8
# Maks. koneksi socket bersamaan per IP
MAX_CONN_PER_IP=20
# Set 1 kalau di belakang nginx/Cloudflare supaya IP asli terbaca dari X-Forwarded-For
TRUST_PROXY=0
# Opsional: TURN (coturn dengan use-auth-secret). Kredensial sementara dibuat otomatis per koneksi.
# TURN_URLS=turn:turn.contoh.com:3478,turns:turn.contoh.com:5349
# TURN_SECRET=rahasia-panjang-acak
